# ---- Database (Postgres) ----
# Local dev with the bundled docker-compose Postgres:
DATABASE_URL="postgresql://bubbly:bubbly@localhost:5432/bubbly?schema=public"

# ---- Admin auth ----
# Used to sign admin session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Seed creates this first admin (change the password after first login:
# Settings → Your password). More admins are added in Settings → Admin users.
SEED_ADMIN_EMAIL="admin@bubblypup.lk"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---- Admin account email (OPTIONAL — Resend) ----
# The ONLY thing WhatsApp can't do: deliver a password-reset link TO an admin.
# Leave blank and everything still works — "Forgot password" then says email
# isn't set up, and a signed-in admin hands out reset links from
# Settings → Admin users instead. Fill these in to email them automatically.
# MAIL_FROM must be a sender Resend has verified for your domain.
RESEND_API_KEY=""
MAIL_FROM="Bubbly Pup <admin@yourdomain.com>"

# ---- WhatsApp auto-send (OPTIONAL — Meta Cloud API) ----
# Leave blank to use the free one-tap wa.me links (no fees, no setup).
# Fill these to send the thank-you AUTOMATICALLY from your business number:
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# A message sent after the visit is outside WhatsApp's 24h window, so Meta needs
# a PRE-APPROVED template. Set its name/language once approved in Meta Business.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# ---- Grooming photos (AWS S3) ----
# Private bucket — the app uploads via presigned PUT and serves via short-lived
# signed GET links, so "Block all public access" stays ON.
# The IAM user needs only PutObject/GetObject/DeleteObject on this one bucket.
S3_BUCKET="bubbly-pup-photos"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
