# Copy to .env.production on the server and fill in real values.
# Used by docker-compose.prod.yml. NEVER commit the filled-in file.

# ---- Postgres (runs in the db container) ----
POSTGRES_USER=bubbly
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=bubbly

# ---- App ----
# Sign admin session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# First admin created by the seed (change the password after first login).
SEED_ADMIN_EMAIL=admin@bubblypup.lk
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---- HTTPS (Caddy / Let's Encrypt) ----
# Point this domain's A record at the VPS public IP first.
DOMAIN=bubblypup.lk
ACME_EMAIL=owner@bubblypup.lk

# ---- Custom domain safety (behind Caddy/Nginx reverse proxy) ----
# Must include every domain the site is served on, or admin actions get rejected.
ALLOWED_ORIGINS=bubblypup.lk,www.bubblypup.lk
# Public site URL for correct SEO / social-share (OpenGraph) links.
SITE_URL=https://bubblypup.lk
