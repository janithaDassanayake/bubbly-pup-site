{
  "name": "bubbly-pop-pet-grooming",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:local": "node scripts/dev-db.mjs",
    "db:up": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "phones:normalise": "tsx scripts/normalise-phones.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.23",
    "next": "^15.5.19",
    "prisma": "^6.19.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.0",
    "typescript": "5.7.3"
  }
}
